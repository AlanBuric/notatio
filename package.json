{
  "name": "rough-notation",
  "version": "0.5.1",
  "description": "Create and animate hand-drawn annotations on a web page",
  "type": "module",
  "types": "./dist/rough-notation.d.ts",
  "module": "./dist/rough-notation.js",
  "exports": {
    ".": {
      "types": "./dist/rough-notation.d.ts",
      "default": "./dist/rough-notation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pshihn/rough-notation.git"
  },
  "keywords": [
    "annotate",
    "rough",
    "sketchy"
  ],
  "author": "Preet Shihn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pshihn/rough-notation/issues"
  },
  "homepage": "https://github.com/pshihn/rough-notation#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "roughjs": "^4.6.6",
    "terser": "^5.49.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
