{
  "name": "notatio",
  "version": "1.0.0",
  "description": "Animated hand-drawn annotations for the web: underline, highlight, circle or strike through any HTML element.",
  "keywords": [
    "annotate",
    "annotation",
    "circle",
    "hand-drawn",
    "highlight",
    "highlighter",
    "rough",
    "rough-notation",
    "roughjs",
    "sketchy",
    "strikethrough",
    "svg",
    "underline",
    "vertical-text"
  ],
  "homepage": "https://github.com/AlanBuric/notatio#readme",
  "bugs": {
    "url": "https://github.com/AlanBuric/notatio/issues"
  },
  "license": "MIT",
  "author": "Alan Burić",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanBuric/notatio.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "roughjs": "^4.6.6",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
